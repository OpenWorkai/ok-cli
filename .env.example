# Copy to .env and fill in your key(s)
# ok-cli loads this file automatically from the current directory.

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override model
# OPENWORK_MODEL=claude-sonnet-4-6

# OpenAI (use with --provider openai --model gpt-4o)
# OPENAI_API_KEY=sk-...

# Google (use with --provider google --model gemini-2.0-flash)
# GOOGLE_API_KEY=AIza...
