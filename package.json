{
  "name": "openwork-cli-root",
  "version": "0.1.0",
  "private": true,
  "description": "OpenWork CLI — ok-cli monorepo",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "bun run --cwd apps/cli src/index.ts",
    "ok": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "hono": "4.12.31",
    "protobufjs": "7.6.5"
  }
}
