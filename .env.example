# Copy to .env and fill in your key(s)
# ok-cli loads this file automatically from the current directory.

# ── Anthropic (default provider) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: override default model ─────────────────────────────────────────
# OPENWORK_MODEL=claude-sonnet-4-6

# ── OpenAI (--provider openai --model gpt-4o) ─────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Google (--provider google --model gemini-2.0-flash) ───────────────────────
# GOOGLE_API_KEY=AIza...

# ── OpenRouter — one key for every model ──────────────────────────────────────
# Get yours at https://openrouter.ai/keys
# Usage: ok-cli --provider openrouter --model anthropic/claude-sonnet-4-6 "..."
# OPENROUTER_API_KEY=sk-or-...

# ── OpenWork Cloud — no key needed, use `ok-cli login` ────────────────────────
# Usage: ok-cli login   then   ok-cli --provider openwork "..."
# (token is stored in ~/.config/ok-cli/auth.json)

# ── NVIDIA NIM — integrate.api.nvidia.com (deepseek/llama/mistral/qwen) ───────
# Get yours at https://build.nvidia.com/
# Usage: ok-cli --provider nvidia --model deepseek-ai/deepseek-v4-flash "..."
# NVIDIA_API_KEY=nvapi-...
