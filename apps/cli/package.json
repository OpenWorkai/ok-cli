{
  "name": "@openwork/cli",
  "version": "0.1.0",
  "description": "ok-cli — OpenWork AI coding agent for your terminal",
  "type": "module",
  "bin": {
    "ok-cli": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run ../../scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenWorkai/ok-cli.git"
  },
  "homepage": "https://github.com/OpenWorkai/ok-cli#readme",
  "bugs": {
    "url": "https://github.com/OpenWorkai/ok-cli/issues"
  },
  "keywords": ["cli", "ai", "agent", "openwork", "coding-agent", "llm"],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.1",
    "@earendil-works/pi-ai": "^0.79.1",
    "@earendil-works/pi-tui": "^0.79.1",
    "@openwork/cloud": "workspace:*",
    "@openwork/core": "workspace:*",
    "@openwork/mcp": "workspace:*",
    "@openwork/peer": "workspace:*",
    "@openwork/peer-rlm": "workspace:*",
    "@openwork/rlm": "workspace:*",
    "@openwork/session-store": "workspace:*",
    "@openwork/skills": "workspace:*",
    "@openwork/tools": "workspace:*",
    "chalk": "^5.4.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
